{
  "// 说明": "双星系统默认配置（P0 审计产出）。路径均可用环境变量覆盖：DSH_BINARY_CONFIG（配置文件路径）、DSH_BINARY_STATE（状态目录）。",

  "dshHome": "$HOME/.dsh",
  "dshPkg": "$NPM_ROOT/@deepseek-ai/dsh",
  "stateDir": "$HOME/.dsh/binary-star",

  "primaryProfile": "web",
  "primaryWorkdir": "$HOME",
  "primaryPort": 3080,
  "picker": "browse",

  "satelliteProfile": "satellite",
  "satelliteWorkdir": "$HOME/.binary-star/sat-workspace",
  "satellitePort": 3081,

  "heartbeat": {
    "intervalMs": 5000,
    "watchIntervalMs": 10000,
    "missThreshold": 3,
    "bootGraceMs": 90000
  },

  "fastPath": {
    "restartAttempts": 2,
    "probeTimeoutMs": 3000,
    "verifyWaitMs": 30000
  },

  "ladder": {
    "autoRepairMaxStep": 3,
    "hourlyRestoreLimit": 2,
    "perRepairRestartLimit": 3
  },

  "journal": {
    "maxRollbackEntries": 10
  },

  "snapshot": {
    "dailyKeep": 7,
    "scope": [
      "profiles/web/cordis.yml",
      "profiles/web/cordis.patch.yml",
      "profiles/web/package.json",
      "profiles/web/pnpm-lock.yaml",
      "profiles/web/pnpm-workspace.yaml",
      "profiles/plugins",
      "settings.yaml"
    ],
    "exclude": ["node_modules", "dist", ".git"]
  },

  "uiPatch": {
    "script": "D:/DSH/ui-patch/patch.js",
    "backup": "D:/DSH/ui-backup",
    "note": "重装 npm 全局包后必须重跑此脚本（补丁对象是 shipped 安装的客户端 bundle）"
  },

  "takeover": {
    "port": 3080,
    "profile": "satellite",
    "autoAfterMs": 1800000,
    "seedLastN": 40,
    "sessionsRoot": "$HOME/.dsh/sessions"
  },

  "autoResume": {
    "enabled": true,
    "message": "[系统] 主星已重启，会话已自动恢复，请继续。"
  }
}
